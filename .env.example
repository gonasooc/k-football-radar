# Local `.env` template. Copy to `.env` and fill in what you need.
# Production values live elsewhere: web build args in deploy/macos/production.env,
# and CI collection secrets in the repo's GitHub Actions secrets.
#
# `next dev` and `next build` load the copied `.env` automatically. The
# collectors read it only through the `:local` scripts, which pass
# `--env-file=.env`; plain `pnpm run collect` uses shell environment variables.

# ── Web app (local `pnpm dev`/`build`) ──
# In production these are injected at build time from deploy/macos/production.env.
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Base URL of the published R2 data snapshot, e.g.
# https://data.k-football-radar.app. Required in production: every data request
# fails rather than quietly falling back to bundled data. In production it is
# injected by deploy/macos/compose.yaml from K_FOOTBALL_RADAR_DATA_BASE_URL.
# Leave empty for local development and tests, which read the repository's data/
# directory. Set it locally only to reproduce what the deployed app is serving.
RADAR_DATA_BASE_URL=

# ── Local collectors ──
# Only needed to run collection locally (pnpm run collect:local /
# collect:youtube:local / backfill:youtube-tags:local). In CI these come from
# GitHub Actions secrets, so leave them empty if you never collect locally.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ── Collection tuning ──
# All optional. An empty or out-of-range value falls back to the in-code default
# shown below, so these exist to make local experiments reproducible.

# Naver news collector.
# Delay between search queries, 0-5000. Protects the API call budget.
NAVER_QUERY_DELAY_MS=800
# Per-request timeout, 1000-30000.
NAVER_FETCH_TIMEOUT_MS=10000

# Official source collector. Per-request timeout, 1000-30000.
OFFICIAL_SOURCE_TIMEOUT_MS=10000

# YouTube collector.
# Days to search on the first run, before a last success time exists, 1-3650.
YOUTUBE_BACKFILL_DAYS=90
# Search result pages per query, 1-5. The main YouTube API quota control.
YOUTUBE_MAX_PAGES_PER_QUERY=2
# Uploads playlist pages per preferred channel, 1-20.
YOUTUBE_MAX_PAGES_PER_CHANNEL=5
# Set to `false` to skip the /shorts/{videoId} probe. Any other value keeps it
# on. With the probe off, only titles and tags that explicitly say Shorts are
# excluded, so more Shorts are kept.
YOUTUBE_SHORTS_REDIRECT_PROBE=true
# ISO-8601 bounds for a manual backfill window, e.g. 2026-01-01T00:00:00Z. Leave
# empty for the normal incremental window. In CI these come from the collect
# workflow's dispatch inputs.
YOUTUBE_PUBLISHED_AFTER=
YOUTUBE_PUBLISHED_BEFORE=

# ── Retention ──
# Applied on every collection run. Items are dropped when they fall outside the
# retention window, then the newest are kept up to each cap. The three caps are
# independent so one kind of item never pushes out another.
# Age limit for every item type, in days, 1-3650. In practice the caps below
# bind first, so raise them before expecting this window to have any effect.
ITEM_RETENTION_DAYS=90
# Cap for primary news and all official items, 1-100000. At the current intake
# of roughly 61 primary items a day this holds about 65 days.
MAX_RETAINED_ITEMS=4000
# Cap for secondary news, 1-100000. Secondary items are only reachable through
# the "전체" scope, so they get a much shorter budget: about 14 days at the
# current intake of roughly 50 a day.
MAX_RETAINED_SECONDARY_ITEMS=700
# Cap for YouTube items, 1-100000.
MAX_RETAINED_YOUTUBE_ITEMS=500
